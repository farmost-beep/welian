<!-- pages/meetings/meetings.wxml — 会议列表页 -->
<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="page-title">🗓️ 会议</text>
    <text class="page-subtitle">拍议程、拍名片、拍笔记，智能帮你记</text>
  </view>

  <!-- 新建会议按钮 -->
  <button class="btn btn-block create-btn" bindtap="openCreate">＋ 新建会议</button>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dimmer text-sm">加载中…</text>
  </view>

  <!-- 错误态 -->
  <view wx:if="{{error && !loading}}" class="loading">
    <text class="text-accent text-sm">{{error}}</text>
    <view style="margin-top:12px"><button size="mini" bindtap="loadMeetings">重试</button></view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && !error && meetings.length === 0}}" class="empty-state">
    <text class="text-dimmer">还没有会议记录</text>
    <text class="text-dimmer text-xs" style="margin-top:8rpx;display:block">点击上方按钮新建一场会议</text>
  </view>

  <!-- 会议列表 -->
  <view wx:if="{{!loading}}">
    <view
      wx:for="{{meetings}}"
      wx:key="id"
      class="card meeting-card"
      bindtap="openDetail"
      bindlongpress="onLongPress"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
    >
      <view class="meeting-card-top">
        <text class="meeting-title">{{item.title}}</text>
        <text class="status-badge status-{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="meeting-meta">
        <text class="meta-item">📅 {{item.dateLabel}}</text>
        <text wx:if="{{item.location}}" class="meta-item">📍 {{item.location}}</text>
      </view>
      <view class="meeting-footer">
        <text class="text-dim text-xs">👥 {{item.attendeeCount}}人</text>
        <text wx:if="{{item.purpose}}" class="text-dimmer text-xs purpose-ellipsis">{{item.purpose}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 新建会议弹窗 -->
<view wx:if="{{showCreate}}" class="modal-overlay" catchtap="closeCreate">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-title">新建会议</view>

    <!-- 拍议程照片 -->
    <view class="modal-field">
      <button class="photo-btn {{scanning ? 'photo-btn-loading' : ''}}" bindtap="scanAgenda" loading="{{scanning}}">
        {{scanning ? '识别中…' : '📷 拍议程照片自动填充'}}
      </button>
    </view>

    <view class="modal-field">
      <text class="modal-label">会议标题</text>
      <input class="modal-input" value="{{form.title}}" bindinput="onFormInput" data-field="title" placeholder="如：XX项目对接会" />
    </view>

    <view class="modal-field">
      <text class="modal-label">日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="modal-input">{{form.date || '选择日期'}}</view>
      </picker>
    </view>

    <view class="modal-field">
      <text class="modal-label">地点</text>
      <input class="modal-input" value="{{form.location}}" bindinput="onFormInput" data-field="location" placeholder="如：陆家嘴XX会议室" />
    </view>

    <view class="modal-field">
      <text class="modal-label">目的</text>
      <textarea class="modal-input modal-textarea" value="{{form.purpose}}" bindinput="onFormInput" data-field="purpose" placeholder="这次会议想达成什么？" />
    </view>

    <view class="modal-actions">
      <button class="action-btn" bindtap="closeCreate">取消</button>
      <button class="action-btn action-btn-primary" bindtap="createMeeting" loading="{{creating}}">创建</button>
    </view>
  </view>
</view>
