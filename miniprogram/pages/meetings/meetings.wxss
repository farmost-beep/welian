/* pages/meetings/meetings.wxss */
.header { margin-bottom: 24rpx; }
.loading { text-align: center; padding: 60rpx 0; }
.empty-state { text-align: center; padding: 80rpx 0; }

/* 新建按钮 */
.create-btn { margin-bottom: 24rpx; }

/* 会议卡片 */
.meeting-card { padding: 24rpx; margin-bottom: 16rpx; }
.meeting-card:active { opacity: 0.85; }
.meeting-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.meeting-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1915;
  flex: 1;
  line-height: 1.4;
}

/* 状态徽章 */
.status-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.status-planned { background: #E0EAF5; color: #3B6FA8; }
.status-ongoing { background: rgba(74,124,89,0.15); color: #4A7C59; }
.status-completed { background: #E4E1D6; color: #9A968C; }

/* 元信息 */
.meeting-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.meta-item { font-size: 26rpx; color: #6B6860; }

.meeting-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.purpose-ellipsis {
  flex: 1;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 弹窗 */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(26,25,21,0.5);
  z-index: 1001;
  display: flex; align-items: flex-end; justify-content: center;
}
.modal-sheet {
  background: #FAFAF7;
  width: 100%; max-width: 500px;
  max-height: 85vh; overflow-y: auto;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
}
.modal-title {
  font-size: 34rpx; font-weight: 600; color: #1A1915;
  text-align: center; margin-bottom: 20rpx;
}
.modal-field { margin-bottom: 16rpx; }
.modal-label {
  font-size: 24rpx; color: #6B6860;
  display: block; margin-bottom: 6rpx;
}
.modal-input {
  border: 1rpx solid #D9D5C7;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  background: #F5F4EE;
  min-height: 40rpx;
}
.modal-textarea { min-height: 120rpx; }
.modal-actions {
  display: flex; gap: 16rpx; margin-top: 24rpx;
}
.modal-actions .action-btn { flex: 1; font-size: 28rpx; padding: 16rpx 0; }
.action-btn { font-size: 14px; padding: 10px 0; background: #EDEBE3; color: #C96442; border: none; border-radius: 10px; }
.action-btn::after { border: none; }
.action-btn-primary { color: #FAFAF7 !important; background: #4A7C59 !important; }

/* 拍照按钮 */
.photo-btn {
  font-size: 28rpx;
  padding: 20rpx 0;
  background: #E8F0E6;
  color: #4A7C59;
  border: 1rpx dashed #4A7C59;
  border-radius: 12rpx;
  text-align: center;
}
.photo-btn::after { border: none; }
.photo-btn-loading { opacity: 0.6; }
