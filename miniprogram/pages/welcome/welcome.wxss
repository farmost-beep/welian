/* pages/welcome/welcome.wxss */
.welcome {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 60rpx;
}

/* 品牌 */
.brand-section {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 12rpx;
}
.brand-name {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: #1A1915;
}
.brand-inf {
  font-size: 64rpx;
  color: #C96442;
}
.brand-tagline {
  font-size: 28rpx;
  color: #6B6860;
  margin-bottom: 64rpx;
  text-align: center;
}
.open-data-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.open-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}
.open-nickname {
  font-size: 26rpx;
  color: #6B6860;
}

/* 价值主张 */
.value-props {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 64rpx;
}
.prop-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.prop-icon {
  font-size: 44rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.prop-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.prop-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1915;
}
.prop-desc {
  font-size: 26rpx;
  color: #6B6860;
  line-height: 1.5;
}

/* CTA */
.cta-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: auto;
}
.btn-primary {
  background: #C96442;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}
.avatar-btn::after { border: none; }
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #EDEBE3;
  border: 2rpx solid #D9D5C7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.nickname-input {
  text-align: center;
  border-bottom: 1rpx solid #D9D5C7;
  padding: 8rpx 0;
  font-size: 28rpx;
  width: 300rpx;
  color: #1A1915;
}
.alt-option {
  display: flex;
  align-items: center;
}

/* 底部 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 40rpx;
}
