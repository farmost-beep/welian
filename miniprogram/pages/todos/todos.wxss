/* pages/todos/todos.wxss */
.header { margin-bottom: 24rpx; }
.loading { text-align: center; padding: 60rpx 0; }
.empty-state { text-align: center; padding: 60rpx 0; }

/* 分组标题 */
.todo-group-header {
  padding: 16rpx 8rpx 8rpx;
  margin-top: 8rpx;
}
.todo-group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B6860;
}

/* 添加待办卡片 */
.add-todo-card { padding: 20rpx 24rpx; margin-bottom: 24rpx; }
.btn-add-todo { background: #4A6741 !important; }
.todo-input {
  border: 1rpx solid #D9D5C7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #F5F4EE;
}
.todo-contact-input { margin-top: 10rpx; font-size: 26rpx; color: #6B6860; }
.todo-datetime-row { display: flex; gap: 10rpx; margin-top: 10rpx; }
.todo-datetime-input {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #6B6860;
}
.long-term-active { border-color: #4A6741; }

/* Tab */
.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: center;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #EDEBE3;
}
.tab-item.active {
  background: #C96442;
}
.tab-item.active .tab-text { color: #fff; }
.tab-text { font-size: 28rpx; color: #6B6860; }
.tab-calendar-btn {
  flex-shrink: 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #EDEBE3;
  color: #4A6741;
}

/* 待办项 */
.todo-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.todo-checkbox {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox-circle {
  font-size: 40rpx;
  color: #9A968C;
}
.checkbox-done {
  color: #4A7C59;
  font-weight: 700;
}
.todo-content { flex: 1; }
.todo-task {
  font-size: 30rpx;
  color: #1A1915;
  line-height: 1.5;
}
.todo-task-done {
  color: #9A968C;
  text-decoration: line-through;
}
.todo-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.todo-priority { font-size: 24rpx; }
.todo-contact { font-size: 24rpx; }
.todo-due { font-size: 24rpx; padding: 2rpx 10rpx; border-radius: 8rpx; }
.todo-due-overdue { color: #c0392b; background: #fdeaea; }
.todo-due-today { color: #e67e22; background: #fef3e0; }
.todo-due-week { color: #6B6860; background: #F5F4EE; }
.todo-due-later { color: #9A968C; }
.todo-due-nodate { color: #9A968C; }
.todo-due-normal { color: #9A968C; }

/* ── 序列卡片 ── */
.todo-series-card {
  padding: 0;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #4A6741;
  overflow: hidden;
}
/* 头部 */
.series-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx 16rpx;
  background: #F5F4EE;
}
.series-header-left {
  flex: 1;
}
.series-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A6741;
  display: block;
  margin-bottom: 8rpx;
}
.series-progress-bar {
  height: 8rpx;
  background: #E4E1D6;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}
.series-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A6741, #5A7A51);
  border-radius: 4rpx;
  transition: width 0.3s;
}
.series-progress-text {
  font-size: 22rpx;
}
.series-chevron {
  font-size: 40rpx;
  color: #9A968C;
  transform: rotate(90deg);
  transition: transform 0.2s;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.series-chevron-up {
  transform: rotate(-90deg);
}
/* 当前步骤 */
.series-current {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}
.series-current-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4A6741;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.series-checkbox {
  width: 40rpx;
  height: 40rpx;
}
.series-current-content {
  flex: 1;
}
/* 展开步骤列表 */
.series-steps {
  padding: 0 24rpx 20rpx 24rpx;
  border-top: 1rpx solid #E8E5DC;
  margin-top: 4rpx;
}
.series-step-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 0 16rpx 0;
  position: relative;
}
.step-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #E4E1D6;
  color: #9A968C;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.step-line {
  position: absolute;
  left: 20rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #E4E1D6;
  z-index: 0;
}
.step-body {
  flex: 1;
  padding-top: 4rpx;
}
.step-due {
  display: block;
  margin-top: 4rpx;
}
.step-check {
  font-size: 32rpx;
  color: #4A6741;
  font-weight: 700;
  flex-shrink: 0;
  padding-top: 2rpx;
}
/* 步骤状态 */
.series-step-row.step-done .step-num {
  background: #4A6741;
  color: #fff;
}
.series-step-row.step-done .step-task {
  color: #9A968C;
  text-decoration: line-through;
}
.series-step-row.step-current .step-num {
  background: #C96442;
  color: #fff;
}
.series-step-row.step-current .step-task {
  color: #1A1915;
  font-weight: 600;
}

/* ── 创建序列弹窗 ── */
.series-create-intro {
  margin-bottom: 20rpx;
}
.series-create-steps {
  margin-bottom: 16rpx;
}
.series-create-step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  position: relative;
  margin-bottom: 4rpx;
}
.series-create-step .step-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4A6741;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  margin-top: 8rpx;
}
.series-create-step .step-num-fixed {
  background: #C96442;
}
.series-create-step .step-line {
  position: absolute;
  left: 20rpx;
  top: 48rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: #D9D5C7;
  z-index: 0;
}
.series-create-step-body {
  flex: 1;
  padding-bottom: 16rpx;
}
.series-create-step-task {
  font-size: 28rpx;
  color: #1A1915;
  display: block;
  padding: 10rpx 0 4rpx;
}
.series-create-input {
  margin-bottom: 8rpx;
}
.series-create-step-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.series-create-date {
  font-size: 24rpx;
  color: #6B6860;
  padding: 6rpx 16rpx;
  background: #F5F4EE;
  border-radius: 8rpx;
  border: 1rpx solid #D9D5C7;
}
.series-create-remove {
  font-size: 28rpx;
  color: #C65D5D;
  padding: 6rpx 12rpx;
}
.series-create-add {
  font-size: 28rpx;
  color: #4A6741;
  text-align: center;
  padding: 16rpx;
  border: 2rpx dashed #C8D5C0;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.todo-postponed { font-size: 24rpx; }

/* 操作菜单 */
.action-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(26,25,21,0.5);
  z-index: 1000;
  display: flex; align-items: flex-end; justify-content: center;
}
.action-sheet {
  background: #FAFAF7;
  width: 100%; max-width: 500px;
  border-radius: 20rpx 20rpx 0 0;
  padding: 16rpx 0 calc(120rpx + env(safe-area-inset-bottom));
}
.action-sheet-title {
  font-size: 26rpx; color: #9A968C;
  text-align: center; padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #E4E1D6;
  margin-bottom: 8rpx;
}
.action-sheet-item {
  font-size: 30rpx; color: #1A1915;
  padding: 24rpx 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #F0EEE8;
}
.action-sheet-item:active { background: #F5F4EE; }
.action-sheet-danger { color: #C65D5D; }
.action-sheet-cancel { margin-top: 12rpx; font-size: 28rpx; color: #6B6860; }

/* 编辑弹窗 */
.edit-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(26,25,21,0.5);
  z-index: 1001;
  display: flex; align-items: flex-end; justify-content: center;
}
.edit-modal {
  background: #FAFAF7;
  width: 100%; max-width: 500px;
  max-height: 85vh; overflow-y: auto;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
}
.edit-title {
  font-size: 34rpx; font-weight: 600; color: #1A1915;
  text-align: center; margin-bottom: 20rpx;
}
.edit-field { margin-bottom: 16rpx; }
.edit-label {
  font-size: 24rpx; color: #6B6860;
  display: block; margin-bottom: 6rpx;
}
.edit-input {
  border: 1rpx solid #D9D5C7;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  background: #F5F4EE;
  min-height: 40rpx;
}
.edit-textarea { min-height: 120rpx; }
.edit-datetime-row { display: flex; gap: 12rpx; }
.edit-datetime-input { flex: 1; text-align: center; }
.edit-actions {
  display: flex; gap: 16rpx; margin-top: 24rpx;
}
.edit-actions .action-btn { flex: 1; font-size: 28rpx; padding: 16rpx 0; }
.action-btn { font-size: 14px; padding: 10px 0; background: #EDEBE3; color: #C96442; border: none; border-radius: 10px; }
.action-btn::after { border: none; }
.action-btn-primary { color: #FAFAF7 !important; background: #4A6741 !important; }

/* 详情弹窗 */
.detail-field { margin-bottom: 20rpx; }
.detail-label {
  font-size: 24rpx; color: #9A968C;
  display: block; margin-bottom: 6rpx;
}
.detail-value {
  font-size: 28rpx; color: #1A1915;
  display: block; line-height: 1.5;
}
