<!-- pages/timeline/timeline.wxml — 互动记录页 -->
<wxs src="../../utils/terminology.wxs" module="term" />
<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="page-title">互动记录</text>
    <text class="page-subtitle">记录每一次用心的互动</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input
      class="search-input"
      type="text"
      placeholder="搜索联系人或摘要…"
      value="{{searchKey}}"
      bindinput="onSearchInput"
    />
    <text wx:if="{{searchKey}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- 添加按钮 -->
  <button class="btn btn-block add-btn" bindtap="openAdd">＋ 添加互动记录</button>

  <!-- #4: 月度点状时间轴 -->
  <view wx:if="{{monthDots.length > 0 && !loading}}" class="month-dot-card card">
    <view class="dot-summary">
      <text class="text-dim text-sm">本月用心 {{monthInteractions}} 次 · {{monthActiveDays}} 天有互动</text>
    </view>
    <view class="dot-grid">
      <view wx:for="{{monthDots}}" wx:key="day" class="dot {{item.intensity}} {{item.isToday ? 'dot-today' : ''}}">
        <text wx:if="{{item.day === 1 || item.day === 10 || item.day === 20}}" class="dot-label text-dimmer">{{item.day}}</text>
      </view>
    </view>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dimmer text-sm">加载中…</text>
  </view>

  <!-- 错误态 -->
  <view wx:if="{{error && !loading}}" class="loading">
    <text class="text-accent text-sm">{{error}}</text>
    <view style="margin-top:12px"><button size="mini" bindtap="loadTimeline">重试</button></view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && !error && groups.length === 0}}" class="empty-state">
    <text class="text-dimmer text-sm">{{searchKey ? '没有匹配的记录' : '还没有互动记录，点击上方添加'}}</text>
  </view>

  <!-- 分组列表 -->
  <block wx:if="{{!loading && !error}}">
    <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
      <view class="month-header">{{group.label}}</view>
      <view
        wx:for="{{group.entries}}"
        wx:key="id"
        wx:for-item="entry"
        class="card timeline-card"
        bindtap="openEdit"
        bindlongpress="onLongPress"
        data-id="{{entry.id}}"
      >
        <view class="timeline-card-header">
          <text class="timeline-name">{{entry.contact_name}}</text>
          <text class="timeline-date text-dim text-xs">{{entry.dateLabel}}</text>
        </view>
        <text class="timeline-summary">{{entry.summary}}</text>
        <view wx:if="{{entry.tags && entry.tags.length}}" class="timeline-tags">
          <text wx:for="{{entry.tags}}" wx:key="*this" wx:for-item="tag" class="tag {{term.tagClass(entry.nature)}}">{{tag}}</text>
        </view>
      </view>
    </block>
  </block>
</view>

<!-- 添加/编辑弹窗 -->
<view wx:if="{{showModal}}" class="edit-overlay" catchtap="closeModal">
  <view class="edit-modal" catchtap="noop">
    <view class="edit-title">{{isEdit ? '编辑互动记录' : '添加互动记录'}}</view>

    <view class="edit-field">
      <text class="edit-label">联系人</text>
      <input
        class="edit-input"
        value="{{form.contact_name}}"
        bindinput="onContactSearch"
        data-field="contact_name"
        placeholder="输入联系人姓名"
      />
      <view wx:if="{{contactSuggestions.length > 0}}" class="contact-suggestions">
        <view wx:for="{{contactSuggestions}}" wx:key="id" class="contact-suggestion-item" bindtap="pickContactSuggestion" data-name="{{item.name}}">
          <text>{{item.name}}</text>
          <text wx:if="{{item.company || item.title}}" class="text-dimmer text-xs">{{item.company}} {{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="edit-field">
      <text class="edit-label">互动摘要</text>
      <textarea
        class="edit-input edit-textarea"
        value="{{form.summary}}"
        bindinput="onFormInput"
        data-field="summary"
        placeholder="记录这次互动的内容…"
        maxlength="500"
      />
    </view>

    <view class="edit-field">
      <text class="edit-label">日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="edit-input">{{form.date || '选择日期'}}</view>
      </picker>
    </view>

    <view class="edit-actions">
      <button class="action-btn" bindtap="closeModal">取消</button>
      <button class="action-btn action-btn-primary" bindtap="saveEntry" loading="{{saving}}">
        {{isEdit ? '保存' : '添加'}}
      </button>
    </view>
  </view>
</view>
