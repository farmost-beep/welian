/* pages/timeline/timeline.wxss */
.header { margin-bottom: 24rpx; }
.loading { text-align: center; padding: 60rpx 0; }
.empty-state { text-align: center; padding: 60rpx 0; }

/* 搜索栏 */
.search-bar {
  position: relative;
  margin-bottom: 16rpx;
}
.search-input {
  background: #EDEBE3;
  border: 1rpx solid #D9D5C7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1A1915;
}
.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #9A968C;
  padding: 8rpx;
}

/* 添加按钮 */
.add-btn {
  margin-bottom: 24rpx;
}

/* #4: 月度点状时间轴 */
.month-dot-card {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.dot-summary {
  margin-bottom: 16rpx;
}
.dot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #E8E5DC;
  position: relative;
}
.dot.low {
  background: #A8C49A;
}
.dot.mid {
  background: #6B8E5A;
}
.dot.high {
  background: #4A6741;
}
.dot-today {
  border: 3rpx solid #C96442;
}
.dot-label {
  position: absolute;
  top: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  white-space: nowrap;
}

/* 月份分组标题 */
.month-header {
  font-size: 28rpx;
  color: #9A968C;
  padding: 16rpx 0 8rpx;
}

/* 互动记录卡片 */
.timeline-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.timeline-card:active {
  background: #E4E1D6;
}
.timeline-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.timeline-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1915;
}
.timeline-date {
  flex-shrink: 0;
}
.timeline-summary {
  font-size: 28rpx;
  color: #6B6860;
  line-height: 1.5;
  display: block;
}
.timeline-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

/* 编辑弹窗 */
.edit-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.edit-modal {
  background: #FAFAF7;
  border-radius: 20rpx;
  padding: 32rpx;
  width: 86%;
  max-height: 80vh;
  overflow-y: auto;
}
.edit-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1915;
  text-align: center;
  margin-bottom: 24rpx;
}
.edit-field {
  margin-bottom: 20rpx;
}
.edit-label {
  font-size: 24rpx;
  color: #6B6860;
  display: block;
  margin-bottom: 8rpx;
}
.edit-input {
  border: 1rpx solid #D9D5C7;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #F5F4EE;
  color: #1A1915;
  min-height: 40rpx;
}
.edit-textarea {
  min-height: 160rpx;
}
.edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.edit-actions .action-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 18rpx 0;
}
.action-btn {
  font-size: 28rpx;
  padding: 18rpx 0;
  background: #EDEBE3;
  color: #6B6860;
  border: none;
  border-radius: 12rpx;
}
.action-btn::after { border: none; }
.action-btn-primary {
  color: #FAFAF7 !important;
  background: #C96442 !important;
}
