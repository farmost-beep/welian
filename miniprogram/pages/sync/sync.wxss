/* pages/sync/sync.wxss — 通用页面渲染器 */
.sync-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F4EE;
}

.sync-status {
  padding: 16rpx 24rpx;
  text-align: center;
}
.sync-status-text {
  font-size: 24rpx;
  color: #C4BFB3;
}

.sync-scroll {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* 气泡布局 */
.sync-bubble-row {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}
.sync-bubble-left {
  justify-content: flex-start;
}
.sync-bubble-right {
  justify-content: flex-end;
}

/* 头像 */
.sync-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #4A6741;
  color: #fff;
  font-size: 36rpx;
  text-align: center;
  line-height: 64rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

/* 气泡样式 */
.sync-bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
}
.sync-bubble-assistant {
  background: #FAFAF7;
  border: 1rpx solid #E8E0D6;
  border-bottom-left-radius: 6rpx;
}
.sync-bubble-user {
  background: #4A6741;
  border-bottom-right-radius: 6rpx;
}
.sync-bubble-name {
  font-size: 22rpx;
  color: #8A8578;
  display: block;
  margin-bottom: 6rpx;
}
.sync-bubble-text {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.sync-bubble-assistant .sync-bubble-text {
  color: #1A1915;
}
.sync-bubble-user .sync-bubble-text {
  color: #fff;
}

/* 锚点 */
.sync-anchor {
  height: 1rpx;
  width: 100%;
}

/* 打字光标 */
.sync-typing-cursor {
  color: #4A6741;
  animation: sync-blink 1s infinite;
}
@keyframes sync-blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 卡片组件 */
.sync-card {
  background: #FAFAF7;
  border: 1rpx solid #E8E0D6;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.sync-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1915;
  margin-bottom: 16rpx;
  display: block;
}
.sync-card-fields {
  margin-bottom: 8rpx;
}
.sync-card-field {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #F0EDE5;
}
.sync-card-field:last-child {
  border-bottom: none;
}
.sync-field-label {
  font-size: 26rpx;
  color: #8A8578;
}
.sync-field-value {
  font-size: 26rpx;
  color: #1A1915;
  text-align: right;
}
.sync-card-items {
  margin-top: 8rpx;
}
.sync-card-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0EDE5;
}
.sync-card-item:last-child {
  border-bottom: none;
}
.sync-item-label {
  font-size: 24rpx;
  color: #8A8578;
  display: block;
}
.sync-item-value {
  font-size: 28rpx;
  color: #1A1915;
  display: block;
  margin-top: 4rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 按钮组 */
.sync-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.sync-btn {
  background: #EDEBE3;
  border: 1rpx solid #D9D5C7;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #4A6741;
}

/* 输入区域 */
.sync-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #EDEBE3;
  border-top: 1rpx solid #D9D5C7;
  flex-shrink: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.sync-input {
  flex: 1;
  background: #fff;
  border: 1rpx solid #D9D5C7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  color: #1A1915;
}
.sync-send {
  margin-left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #4A6741;
  color: #fff;
  border-radius: 50%;
  font-size: 36rpx;
  flex-shrink: 0;
}

.sync-attachment {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  margin-right: 12rpx;
  border: 2rpx solid #4A6741;
  border-radius: 50%;
  color: #4A6741;
  background: #FAFAF7;
  text-align: center;
  font-size: 42rpx;
  font-weight: 300;
  flex-shrink: 0;
}

.relationship-import-status {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  padding: 8rpx 24rpx;
  background: #FAFAF7;
  border-top: 1rpx solid #E8E0D6;
}
.relationship-import-status-text,
.relationship-import-error {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8A8578;
}
.relationship-import-error {
  color: #B65D42;
}
.relationship-retry {
  margin-left: 20rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #4A6741;
  border-radius: 24rpx;
  color: #4A6741;
  font-size: 24rpx;
  flex-shrink: 0;
}

.relationship-overlay {
  position: fixed;
  z-index: 1000;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(26, 25, 21, 0.48);
}
.relationship-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  max-height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 24rpx;
  background: #FAFAF7;
  box-shadow: 0 12rpx 48rpx rgba(26, 25, 21, 0.2);
}
.relationship-dialog-header {
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #E8E0D6;
  flex-shrink: 0;
}
.relationship-dialog-title {
  display: block;
  color: #1A1915;
  font-size: 36rpx;
  font-weight: 600;
}
.relationship-dialog-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8A8578;
  font-size: 24rpx;
}
.relationship-apply-feedback {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF2EC;
}
.relationship-apply-feedback-text {
  display: block;
  color: #B65D42;
  font-size: 24rpx;
  line-height: 1.5;
}
.relationship-preview-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
}
.relationship-summary {
  padding-bottom: 20rpx;
}
.relationship-summary-text {
  display: block;
  margin-top: 10rpx;
  color: #1A1915;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}
.relationship-source {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #F0EDE5;
}
.relationship-counts {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx 12rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #F0EDE5;
}
.relationship-count {
  width: 25%;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
  text-align: center;
}
.relationship-count-value {
  display: block;
  color: #4A6741;
  font-size: 32rpx;
  font-weight: 600;
}
.relationship-count-label {
  display: block;
  margin-top: 2rpx;
  color: #8A8578;
  font-size: 22rpx;
}
.relationship-section {
  padding: 18rpx 0 4rpx;
  border-top: 1rpx solid #E8E0D6;
}
.relationship-section-title {
  display: block;
  color: #4A6741;
  font-size: 28rpx;
  font-weight: 600;
}
.relationship-entry {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EDE5;
}
.relationship-entry:last-child {
  border-bottom: none;
}
.relationship-entry-head {
  display: flex;
  align-items: center;
}
.relationship-operation {
  margin-right: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #E5EEE1;
  color: #4A6741;
  font-size: 22rpx;
  flex-shrink: 0;
}
.relationship-entry-title {
  display: block;
  color: #1A1915;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}
.relationship-entry-meta,
.relationship-entry-confidence,
.relationship-entry-evidence {
  display: block;
  margin-top: 5rpx;
  color: #8A8578;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}
.relationship-entry-confidence {
  color: #4A6741;
}
.relationship-entry-evidence {
  color: #A36B54;
}
.relationship-warning-section .relationship-section-title {
  color: #B65D42;
}
.relationship-dialog-actions {
  display: flex;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E8E0D6;
  background: #FAFAF7;
  flex-shrink: 0;
}
.relationship-dialog-actions button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0 8rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.relationship-dialog-actions button::after {
  border: none;
}
.relationship-cancel {
  color: #4A6741;
  background: #EDEBE3;
}
.relationship-confirm {
  color: #fff;
  background: #4A6741;
}
