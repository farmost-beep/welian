/* pages/network/network.wxss */
.network-page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  background: #F5F4EE;
}

.header {
  margin-bottom: 32rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1915;
  display: block;
}
.page-subtitle {
  margin-top: 4rpx;
  display: block;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #EDEBE3;
  color: #6B6860;
  font-size: 28rpx;
  font-weight: 600;
}
.mode-tab.active {
  background: #C96442;
  color: #fff;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

/* 节点网格 */
.nodes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.node-card {
  width: calc(50% - 8rpx);
  background: #FAFAF7;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #E8E5DC;
  position: relative;
}
.node-leverage {
  border-left: 4rpx solid #4A6741;
}
.node-nurture {
  border-left: 4rpx solid #D4A574;
}
.node-dual {
  border-left: 4rpx solid #C96442;
}
.node-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1915;
  display: block;
}
.node-company {
  margin-top: 4rpx;
  display: block;
}
.node-nature-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  color: #9A968C;
}

/* 连接列表 */
.edges-section {
  background: #FAFAF7;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #E8E5DC;
}
.section-title-sm {
  font-size: 24rpx;
  color: #9A968C;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.edge-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #E8E5DC;
}
.edge-row:last-child {
  border-bottom: none;
}
.edge-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1915;
}
.edge-arrow {
  color: #C96442;
  font-size: 28rpx;
}
.edge-desc {
  flex: 1;
  margin-left: 8rpx;
}

/* 引荐路径 */
.path-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.path-input {
  background: #FAFAF7;
  border: 1rpx solid #E8E5DC;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1A1915;
}
.btn-primary {
  background: #C96442;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.path-result {
  background: #FAFAF7;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #E8E5DC;
}
.path-found {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.path-title {
  color: #1A1915;
}
.path-chain {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.path-node {
  font-size: 32rpx;
  font-weight: 600;
  color: #C96442;
}
.path-not-found {
  text-align: center;
  padding: 20rpx;
}

/* 隐私说明 */
.privacy-note {
  margin-top: 40rpx;
  text-align: center;
  padding: 20rpx;
}
