<!-- pages/dashboard/dashboard.wxml — 角色仪表盘 -->
<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="page-title">{{userName || '你好'}}</text>
    <text class="page-subtitle">每段关系都值得用心</text>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dimmer text-sm">正在回顾你本月的故事…</text>
  </view>

  <!-- 错误态 -->
  <view wx:if="{{error && !loading}}" class="loading">
    <text class="text-accent text-sm">{{error}}</text>
    <view style="margin-top:12px"><button size="mini" bindtap="loadDashboard">重试</button></view>
  </view>

  <block wx:if="{{!loading && !error}}">
    <!-- 统计概览 -->
    <view wx:if="{{!isEmpty}}" class="stats-bar">
      <view class="stat-item">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-label text-dimmer text-xs">联系人</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.leverage}}</text>
        <text class="stat-label text-dimmer text-xs">经营型</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.nurture}}</text>
        <text class="stat-label text-dimmer text-xs">陪伴型</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{pendingCount}}</text>
        <text class="stat-label text-dimmer text-xs">待办</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-links">
      <view class="quick-link" bindtap="goWeekly">
        <text class="quick-icon">📋</text>
        <text class="quick-text text-sm">周报</text>
      </view>
      <view class="quick-link" bindtap="goMonthly">
        <text class="quick-icon">📊</text>
        <text class="quick-text text-sm">月报</text>
      </view>
      <view class="quick-link" bindtap="goAnnual">
        <text class="quick-icon">🎉</text>
        <text class="quick-text text-sm">年度</text>
      </view>
      <view class="quick-link" bindtap="goMeetings">
        <text class="quick-icon">🤝</text>
        <text class="quick-text text-sm">会议</text>
      </view>
      <view class="quick-link" bindtap="goTimeline">
        <text class="quick-icon">📖</text>
        <text class="quick-text text-sm">互动</text>
      </view>
      <view wx:if="{{syncPinned}}" class="quick-link" bindtap="goSync">
        <text class="quick-icon">🌱</text>
        <text class="quick-text text-sm">小维</text>
      </view>
    </view>

    <!-- 今日信号 -->
    <view wx:if="{{flags.signals && signals.length > 0}}" class="card signal-preview" bindtap="goSignals">
      <view class="section-title-sm">今日信号</view>
      <view wx:for="{{signals}}" wx:key="index" class="signal-item">
        <text class="text-sm">{{item.title || item.topic || item}}</text>
      </view>
      <text class="text-dimmer text-xs" style="margin-top:8rpx;display:block">查看全部 →</text>
    </view>

    <!-- 今日待办摘要 -->
    <view wx:if="{{flags.todo_summary && todoSummary && (todoSummary.overdue.length > 0 || todoSummary.today.length > 0)}}" class="card todo-summary" bindtap="goTodos">
      <view class="section-title-sm">待办提醒</view>
      <view wx:if="{{todoSummary.overdue.length > 0}}" class="todo-group">
        <text class="todo-group-label text-accent text-sm">已超期</text>
        <view wx:for="{{todoSummary.overdue}}" wx:key="id" class="todo-row">
          <text class="todo-priority">{{item.priority === 'P1' ? '🔴' : '🟡'}}</text>
          <text class="todo-task text-sm">{{item.task}}</text>
        </view>
      </view>
      <view wx:if="{{todoSummary.today.length > 0}}" class="todo-group">
        <text class="todo-group-label text-sm">今天</text>
        <view wx:for="{{todoSummary.today}}" wx:key="id" class="todo-row">
          <text class="todo-priority">{{item.priority === 'P1' ? '🔴' : '🟡'}}</text>
          <text class="todo-task text-sm">{{item.task}}</text>
        </view>
      </view>
      <text class="text-dimmer text-xs" style="margin-top:8rpx;display:block">查看全部 →</text>
    </view>

    <!-- R2-2: 本周最值得做的一件事 -->
    <view wx:if="{{!isEmpty && actionCard}}" class="card action-card" bindtap="onActionCardTap">
      <view class="ac-header">
        <text class="ac-icon">🎯</text>
        <text class="ac-title">本周最值得做</text>
      </view>
      <text class="ac-reason text-sm">{{actionCard.reason}}</text>
      <view wx:if="{{actionCard.contact}}" class="ac-contact">
        <text class="ac-contact-name text-sm">{{actionCard.contact.name}}</text>
        <text class="ac-topic text-dimmer text-xs">{{actionCard.suggested_topic}}</text>
      </view>
      <view class="ac-actions">
        <view class="ac-btn ac-btn-primary" catchtap="onActionCardDraft" data-contact-id="{{actionCard.contact.id}}" data-todo-id="{{actionCard.todo_id || ''}}">拟消息</view>
        <view class="ac-btn ac-btn-secondary" catchtap="onActionCardDone" data-contact-id="{{actionCard.contact.id}}" data-todo-id="{{actionCard.todo_id || ''}}">已联系</view>
        <view class="ac-btn ac-btn-ghost" catchtap="onActionCardSkip">跳过</view>
      </view>
    </view>

    <!-- 近期重要日期 -->
    <view wx:if="{{flags.upcoming_dates && upcomingDates.length > 0}}" class="card upcoming-card">
      <view class="section-title-sm">近期重要日期</view>
      <view wx:for="{{upcomingDates}}" wx:key="index" class="upcoming-row">
        <text class="upcoming-icon">{{item.label === '生日' ? '🎂' : '📅'}}</text>
        <text class="text-sm">{{item.name}}的{{item.label}}</text>
        <text class="text-dimmer text-xs upcoming-days">{{item.days}}天后</text>
      </view>
    </view>

    <!-- AI 行为洞察（自进化） -->
    <view wx:if="{{flags.insights && insights.length > 0}}" class="card insights-card">
      <view class="section-title-sm">AI 洞察 <text class="text-dimmer text-xs" style="font-weight:normal">·每周自动生成</text></view>
      <view wx:for="{{insights}}" wx:key="index" class="insight-row">
        <text class="insight-dot">·</text>
        <text class="text-sm">{{item}}</text>
      </view>
    </view>

    <!-- 新用户引导 -->
    <view wx:if="{{isEmpty}}" class="card empty-guide">
      <text class="text-accent" style="font-size:16px;font-weight:600">还没有联系人数据</text>
      <text class="text-dim text-sm" style="margin-top:8px;display:block">去「关系」页添加几个重要的人，开始记录你们的互动，仪表盘就会显示你的月度行为回顾。</text>
      <button class="btn btn-block" style="margin-top:12px" bindtap="goContacts">去添加联系人</button>
    </view>

    <!-- 三角色分栏 -->
    <block wx:for="{{roles}}" wx:key="key">
      <view class="card role-card">
        <view class="role-header">
          <text class="role-icon">{{item.icon}}</text>
          <text class="role-label">{{item.label}}</text>
        </view>
        <view class="role-items">
          <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="index" class="role-item {{entry.actionable ? 'role-item-actionable' : ''}}" bindtap="{{entry.actionable ? 'goDraftMessage' : ''}}" data-name="{{entry.contactName || ''}}">
            <text class="item-dot {{entry.tone}}">·</text>
            <text class="item-text {{entry.tone === 'warning' ? 'text-accent' : ''}} {{entry.tone === 'positive' ? 'text-green' : ''}}">{{entry.text}}{{entry.actionable ? ' →拟消息' : ''}}</text>
          </view>
        </view>
        <!-- 最近互动摘要 -->
        <view wx:if="{{item.recentInteractions && item.recentInteractions.length > 0}}" class="recent-interactions">
          <view wx:for="{{item.recentInteractions}}" wx:for-item="ri" wx:key="id" class="recent-item" bindtap="goTimeline">
            <text class="recent-name text-sm text-dim">{{ri.name}}</text>
            <text class="recent-summary text-sm text-dimmer">{{ri.summary}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 进化阶段（底部） -->
    <view wx:if="{{!isEmpty && flags.evolution && evolution}}" class="card evolution-card">
      <view class="evolution-header">
        <text class="evolution-icon">{{evolution.icon}}</text>
        <text class="evolution-name">{{evolution.name}}</text>
        <text wx:if="{{evolution.next}}" class="text-dimmer text-xs">→ {{evolution.nextIcon}} {{evolution.next}}</text>
        <text wx:else class="text-dimmer text-xs">已满级</text>
      </view>
      <view class="evolution-progress-wrap">
        <view class="evolution-progress-bar">
          <view class="evolution-progress-fill" style="width:{{evolution.progress}}%"></view>
        </view>
        <text class="evolution-progress-text text-xs text-dimmer">{{evolution.progress}}%</text>
      </view>
      <text wx:if="{{evolution.next}}" class="evolution-gap text-dimmer text-xs">还需 {{evolution.needContacts}} 联系人 · {{evolution.needInteractions}} 互动</text>
      <!-- 阶段徽章 -->
      <view class="evolution-badges">
        <text wx:for="{{evolution.stages}}" wx:key="name" class="evolution-badge {{item.unlocked ? 'unlocked' : ''}}">{{item.icon}} {{item.name}}</text>
      </view>
      <text class="evolution-desc text-dimmer text-xs">关系网络成长度 · 多记录互动，自然会成长</text>
    </view>

    <!-- 进化指标 2x2 网格 -->
    <view wx:if="{{!isEmpty && flags.evolution && evolutionMetrics}}" class="card evolution-metrics-card">
      <text class="section-title-sm">📊 进化指标</text>
      <view class="metrics-grid">
        <view class="metric-item">
          <text class="metric-num">{{evolutionMetrics.monthInteractions}}</text>
          <text class="metric-label text-dimmer text-xs">本月互动</text>
        </view>
        <view class="metric-item">
          <text class="metric-num">{{evolutionMetrics.totalInteractions}}</text>
          <text class="metric-label text-dimmer text-xs">互动总数</text>
        </view>
        <view class="metric-item">
          <text class="metric-num">{{evolutionMetrics.contactCount}}</text>
          <text class="metric-label text-dimmer text-xs">联系人</text>
        </view>
        <view class="metric-item">
          <text class="metric-num">{{stats.leverage}}</text>
          <text class="metric-label text-dimmer text-xs">经营型</text>
        </view>
      </view>
    </view>

    <!-- R2-4: 自进化行为洞察 -->
    <view wx:if="{{!isEmpty && behavioralInsights}}" class="card behavioral-insights-card">
      <view class="bi-header">
        <text class="bi-icon">🧠</text>
        <text class="section-title-sm">小维学到了</text>
      </view>
      <text class="bi-body text-sm">{{behavioralInsights.insights}}</text>
      <view class="bi-meta">
        <text class="text-dimmer text-xs">依据：过去 {{behavioralInsights.based_on.weeks_analyzed}} 周 {{behavioralInsights.based_on.total_actions}} 次行动 · 采纳率 {{behavioralInsights.based_on.adoption_rate}}%</text>
      </view>
      <view class="bi-actions">
        <text class="bi-reset-link text-dimmer text-xs" bindtap="resetBehavioralInsights">重置</text>
      </view>
    </view>

    <!-- 底部说明 -->
    <view class="footer-note">
      <text class="text-dimmer text-xs">Welian 只做行为回顾，不做评分。这个月过得怎么样，由你判断。</text>
    </view>
  </block>
</view>

<!-- 进化阶段升级通知 -->
<view wx:if="{{stageUpgrade}}" class="modal-overlay" catchtap="closeStageUpgrade">
  <view class="modal-sheet" catchtap="noop">
    <view class="stage-upgrade-icon">{{stageUpgrade.icon}}</view>
    <view class="stage-upgrade-title">🎉 进化到了「{{stageUpgrade.name}}」阶段！</view>
    <text class="stage-upgrade-desc text-dim text-sm">你的小维现在掌握了 {{stageUpgrade.contacts}} 段关系和 {{stageUpgrade.interactions}} 条互动记忆</text>
    <view class="modal-actions">
      <button class="action-btn action-btn-primary" bindtap="closeStageUpgrade">继续成长</button>
    </view>
  </view>
</view>
