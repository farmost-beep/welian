<!-- pages/dashboard/dashboard.wxml — 角色仪表盘 -->
<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dimmer text-sm">正在回顾你本月的故事…</text>
  </view>

  <!-- 错误态 -->
  <view wx:if="{{error && !loading}}" class="loading">
    <text class="text-accent text-sm">{{error}}</text>
    <view style="margin-top:12px"><button size="mini" bindtap="loadDashboard">重试</button></view>
  </view>

  <!-- 未登录态 — 允许游客体验 app shell（审核要求：可跳过登录） -->
  <view wx:if="{{notLoggedIn && !loading && !error}}" class="loading">
    <text class="text-sm" style="margin-bottom:8px">登录后查看你的关系网络</text>
    <text class="text-dimmer text-xs" style="margin-bottom:20px">Welian 帮你成为更好的朋友、更好的家人、更好的合作者</text>
    <button class="btn btn-primary" size="mini" bindtap="goLogin">微信登录</button>
  </view>

  <block wx:if="{{!loading && !error && !notLoggedIn}}">
    <!-- 月度故事卡 — 标语 + 叙事 + 进化树印章 -->
    <view wx:if="{{!isEmpty}}" class="card story-card">
      <view class="story-header">
        <view class="story-text-wrap">
          <text class="story-belief">每段关系都值得用心</text>
          <text class="story-text text-sm">{{storyText}}</text>
        </view>
        <view wx:if="{{evolution}}" class="tree-seal">
          <view class="tree-glow"></view>
          <text class="tree-icon {{treeAnimation ? 'tree-breathe' : ''}}">{{evolution.icon}}</text>
          <view wx:if="{{treeLeaf}}" class="tree-leaf">{{treeLeaf}}</view>
        </view>
      </view>
      <view class="story-stats">
        <text class="story-stat text-dimmer text-xs">{{stats.total}} 联系人</text>
        <text class="story-stat text-dimmer text-xs">·</text>
        <text class="story-stat text-dimmer text-xs">{{evolutionMetrics.monthInteractions}} 次本月互动</text>
        <text class="story-stat text-dimmer text-xs">·</text>
        <text class="story-stat text-dimmer text-xs">{{pendingCount}} 待办</text>
      </view>
    </view>

    <!-- #5: 季节性关系提醒 -->
    <view wx:if="{{seasonalCard}}" class="card seasonal-card">
      <text class="seasonal-emoji">{{seasonalCard.emoji}}</text>
      <view class="seasonal-body">
        <text class="seasonal-title text-sm">{{seasonalCard.title}}</text>
        <text class="seasonal-hint text-dimmer text-xs">{{seasonalCard.hint}}</text>
      </view>
    </view>

    <!-- 今日信号 -->
    <view wx:if="{{flags.signals && signals.length > 0}}" class="card signal-preview" bindtap="goSignals">
      <view class="section-title-sm">今日信号</view>
      <view wx:for="{{signals}}" wx:key="index" class="signal-item">
        <text class="text-sm">{{item.title || item.topic || item}}</text>
      </view>
      <text class="text-dimmer text-xs" style="margin-top:8rpx;display:block">查看全部 →</text>
    </view>

    <!-- 今日待办摘要 -->
    <view wx:if="{{flags.todo_summary && todoSummary && (todoSummary.overdue.length > 0 || todoSummary.today.length > 0)}}" class="card todo-summary" bindtap="goTodos">
      <view class="section-title-sm">待办提醒</view>
      <view wx:if="{{todoSummary.overdue.length > 0}}" class="todo-group">
        <text class="todo-group-label text-accent text-sm">已超期</text>
        <view wx:for="{{todoSummary.overdue}}" wx:key="id" class="todo-row">
          <text class="todo-priority {{item.priority === 'P1' ? 'priority-p1' : 'priority-p2'}}">{{item.priority}}</text>
          <text class="todo-task text-sm">{{item.task}}</text>
        </view>
      </view>
      <view wx:if="{{todoSummary.today.length > 0}}" class="todo-group">
        <text class="todo-group-label text-sm">今天</text>
        <view wx:for="{{todoSummary.today}}" wx:key="id" class="todo-row">
          <text class="todo-priority {{item.priority === 'P1' ? 'priority-p1' : 'priority-p2'}}">{{item.priority}}</text>
          <text class="todo-task text-sm">{{item.task}}</text>
        </view>
      </view>
      <text class="text-dimmer text-xs" style="margin-top:8rpx;display:block">查看全部 →</text>
    </view>

    <!-- R2-2: 本周最值得做的一件事 -->
    <view wx:if="{{!isEmpty && actionCard}}" class="card action-card" bindtap="onActionCardTap" data-action-id="{{actionCard.action_id || actionCard.id}}">
      <view class="ac-header">
        <text class="ac-title">本周最值得做</text>
        <text wx:if="{{actionCard.series_id}}" class="ac-series-badge">{{actionCard.series_label}} · 步骤 {{actionCard.series_order + 1}}/{{actionCard.series_total}}</text>
      </view>
      <text class="ac-reason text-sm">{{actionCard.reason}}</text>
      <view wx:if="{{actionCard.why_now}}" class="ac-why-now">
        <text class="ac-why-now-label text-dimmer text-xs">为什么是现在：{{actionCard.why_now}}</text>
      </view>
      <view wx:if="{{actionCard.contact}}" class="ac-contact">
        <text class="ac-contact-name text-sm">{{actionCard.contact.name}}</text>
        <text class="ac-topic text-dimmer text-xs">{{actionCard.suggested_topic}}</text>
      </view>
      <view wx:if="{{actionCard.source && actionCard.source.evidence}}" class="ac-source">
        <text class="ac-source-label text-dimmer text-xs">依据：{{actionCard.source.evidence}}</text>
      </view>
      <view class="ac-actions">
        <button class="ac-btn" catchtap="onActionCardDraft" disabled="{{actionBusy}}" loading="{{actionBusy && drafting}}" data-action-id="{{actionCard.action_id || actionCard.id}}" data-action-version="{{actionCard.version}}" data-contact-id="{{actionCard.contact.id}}" data-todo-id="{{actionCard.todo_id || ''}}">拟消息</button>
        <button class="ac-btn" catchtap="onActionCardDone" disabled="{{actionBusy}}" loading="{{actionBusy && drafting}}" data-action-id="{{actionCard.action_id || actionCard.id}}" data-action-version="{{actionCard.version}}" data-contact-id="{{actionCard.contact.id}}" data-todo-id="{{actionCard.todo_id || ''}}">已完成</button>
        <button class="ac-btn" catchtap="onActionCardSnooze" disabled="{{actionBusy}}" loading="{{actionBusy && drafting}}" data-action-id="{{actionCard.action_id || actionCard.id}}" data-action-version="{{actionCard.version}}" data-contact-id="{{actionCard.contact.id}}" data-todo-id="{{actionCard.todo_id || ''}}">稍后</button>
        <button class="ac-btn ac-btn-skip" catchtap="onActionCardSkip" disabled="{{actionBusy}}" loading="{{actionBusy && drafting}}" data-action-id="{{actionCard.action_id || actionCard.id}}" data-action-version="{{actionCard.version}}">跳过</button>
      </view>
    </view>

    <!-- 近期重要日期 -->
    <view wx:if="{{flags.upcoming_dates && upcomingDates.length > 0}}" class="card upcoming-card">
      <view class="section-title-sm">近期重要日期</view>
      <view wx:for="{{upcomingDates}}" wx:key="index" class="upcoming-row">
        <text class="upcoming-icon">{{item.label}}</text>
        <text class="text-sm">{{item.name}}的{{item.label}}</text>
        <text class="text-dimmer text-xs upcoming-days">{{item.days}}天后</text>
      </view>
    </view>

    <!-- AI 行为洞察（自进化） -->
    <view wx:if="{{flags.insights && insights.length > 0}}" class="card insights-card">
      <view class="section-title-sm">AI 洞察 <text class="text-dimmer text-xs" style="font-weight:normal">·每周自动生成</text></view>
      <view wx:for="{{insights}}" wx:key="index" class="insight-row">
        <text class="insight-dot">·</text>
        <text class="text-sm">{{item}}</text>
      </view>
    </view>

    <!-- 新用户引导 -->
    <view wx:if="{{isEmpty}}" class="card empty-guide">
      <text class="text-accent" style="font-size:16px;font-weight:600">还没有联系人数据</text>
      <text class="text-dim text-sm" style="margin-top:8px;display:block">去「关系」页添加几个重要的人，开始记录你们的互动，仪表盘就会显示你的月度行为回顾。</text>
      <button class="btn btn-block" style="margin-top:12px" bindtap="goContacts">去添加联系人</button>
    </view>

    <!-- 三角色分栏 -->
    <block wx:if="{{flags.roles}}" wx:for="{{roles}}" wx:key="key">
      <view class="card role-card">
        <view class="role-header">
          <text class="role-icon">{{item.icon}}</text>
          <text class="role-label">{{item.label}}</text>
        </view>
        <view class="role-items">
          <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="index" class="role-item {{entry.actionable ? 'role-item-actionable' : ''}}" bindtap="{{entry.actionable ? 'goDraftMessage' : ''}}" data-name="{{entry.contactName || ''}}">
            <text class="item-dot {{entry.tone}}">·</text>
            <text class="item-text {{entry.tone === 'warning' ? 'text-accent' : ''}} {{entry.tone === 'positive' ? 'text-green' : ''}}">{{entry.text}}{{entry.actionable ? ' →拟消息' : ''}}</text>
          </view>
        </view>
        <!-- 最近互动摘要 -->
        <view wx:if="{{item.recentInteractions && item.recentInteractions.length > 0}}" class="recent-interactions">
          <view wx:for="{{item.recentInteractions}}" wx:for-item="ri" wx:key="id" class="recent-item" bindtap="goTimeline">
            <text class="recent-name text-sm text-dim">{{ri.name}}</text>
            <text class="recent-summary text-sm text-dimmer">{{ri.summary}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 底部说明 -->
    <view class="footer-note">
      <text class="text-dimmer text-xs">Welian 只做行为回顾，不做评分。这个月过得怎么样，由你判断。</text>
    </view>
  </block>
</view>

<!-- 进化阶段升级通知 -->
<view wx:if="{{stageUpgrade}}" class="modal-overlay" catchtap="closeStageUpgrade">
  <view class="modal-sheet" catchtap="noop">
    <view class="stage-upgrade-icon">{{stageUpgrade.icon}}</view>
    <view class="stage-upgrade-title">进化到了「{{stageUpgrade.name}}」阶段！</view>
    <text class="stage-upgrade-desc text-dim text-sm">你的小维现在掌握了 {{stageUpgrade.contacts}} 段关系和 {{stageUpgrade.interactions}} 条互动记忆</text>
    <view class="modal-actions">
      <button class="action-btn action-btn-primary" bindtap="closeStageUpgrade">继续成长</button>
    </view>
  </view>
</view>
