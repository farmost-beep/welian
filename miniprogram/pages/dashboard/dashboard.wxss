/* pages/dashboard/dashboard.wxss */

.header {
  margin-bottom: 32rpx;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
}

/* ── 统计概览 ── */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 16rpx;
  margin-bottom: 24rpx;
  background: #EDEBE3;
  border-radius: 16rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #C96442;
}
.stat-label {
  font-size: 22rpx;
}

/* ── 快捷入口 ── */
.quick-links {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 16rpx;
  margin-bottom: 24rpx;
}
.quick-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.quick-icon {
  font-size: 40rpx;
}
.quick-text {
  color: #6B6860;
}

/* ── 信号预览 ── */
.signal-preview {
  margin-bottom: 24rpx;
}
.signal-item {
  padding: 8rpx 0;
  border-bottom: 1rpx solid #D9D5C7;
}
.signal-item:last-child {
  border-bottom: none;
}

/* ── 新用户引导 ── */
.empty-guide {
  text-align: center;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
}

/* ── 角色卡片 ── */
.role-card {
  margin-bottom: 24rpx;
}

.role-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.role-icon {
  font-size: 40rpx;
}

.role-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1915;
}

/* ── 行为条目 ── */
.role-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.item-dot {
  font-size: 36rpx;
  line-height: 1.4;
  color: #6B6860;
  flex-shrink: 0;
}

.item-dot.positive { color: #4A7C59; }
.item-dot.warning  { color: #C96442; }

.item-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1915;
  flex: 1;
}

/* ── 底部 ── */
.footer-note {
  text-align: center;
  padding: 40rpx 20rpx;
  line-height: 1.8;
}

/* ── R2-4: 自进化行为洞察 ── */
.behavioral-insights-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.bi-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bi-icon {
  font-size: 36rpx;
}
.bi-body {
  color: #3A3833;
  line-height: 1.7;
  white-space: pre-wrap;
}
.bi-meta {
  padding-top: 8rpx;
  border-top: 1rpx solid #E8E5DC;
}
.bi-actions {
  display: flex;
  justify-content: flex-end;
}
.bi-reset-link {
  padding: 8rpx 16rpx;
}

/* ── 待办摘要 ── */
.todo-summary {
  margin-bottom: 24rpx;
}
.todo-group {
  margin-top: 12rpx;
}
.todo-group-label {
  display: block;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.todo-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
}
.todo-priority {
  flex-shrink: 0;
  font-size: 24rpx;
}
.todo-task {
  flex: 1;
  color: #1A1915;
}

/* ── 可点击冷却条目 ── */
.role-item-actionable {
  background: #F2E8E0;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  margin-left: -12rpx;
}
.role-item-actionable:active {
  background: #E8D9CC;
}

/* ── 最近互动摘要 ── */
.recent-interactions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #D9D5C7;
}
.recent-item {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
  gap: 4rpx;
}
.recent-item:active {
  opacity: 0.6;
}
.recent-name {
  font-weight: 600;
}
.recent-summary {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 进化阶段 ── */
.evolution-card {
  margin-bottom: 24rpx;
}
.evolution-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.evolution-icon {
  font-size: 20px;
}
.evolution-name {
  font-size: 16px;
  font-weight: 600;
  color: #4A6741;
}
.evolution-progress-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.evolution-progress-bar {
  flex: 1;
  height: 12rpx;
  background: #E8E2D8;
  border-radius: 6rpx;
  overflow: hidden;
}
.evolution-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A6741, #7ec47e);
  border-radius: 6rpx;
  transition: width 0.5s;
}
.evolution-gap {
  display: block;
  margin-top: 8rpx;
}
.evolution-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.evolution-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #F5F4EE;
  color: #8B8B8B;
}
.evolution-badge.unlocked {
  background: #4A6741;
  color: #fff;
}
.evolution-desc {
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ── 进化指标 2x2 网格 ── */
.evolution-metrics-card {
  margin-bottom: 24rpx;
}
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 12rpx;
}
.metric-item {
  text-align: center;
  padding: 16rpx 8rpx;
  background: #F5F4EE;
  border-radius: 12rpx;
}
.metric-num {
  display: block;
  font-size: 20px;
  font-weight: 600;
  color: #4A6741;
  margin-bottom: 4rpx;
}

/* ── 升级通知弹窗 ── */
.stage-upgrade-icon {
  font-size: 48px;
  text-align: center;
  margin-bottom: 16rpx;
}
.stage-upgrade-title {
  font-size: 18px;
  font-weight: 600;
  color: #4A6741;
  text-align: center;
  margin-bottom: 12rpx;
}
.stage-upgrade-desc {
  display: block;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* ── 弹窗 ── */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(26,25,21,0.5);
  z-index: 1001;
  display: flex; align-items: flex-end; justify-content: center;
}
.modal-sheet {
  background: #FAFAF7;
  width: 100%; max-width: 500px;
  border-radius: 20rpx 20rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}
.modal-actions {
  display: flex; gap: 16rpx; margin-top: 8rpx;
}
.modal-actions .action-btn { flex: 1; font-size: 28rpx; padding: 16rpx 0; }
.action-btn { font-size: 14px; padding: 10px 0; background: #EDEBE3; color: #C96442; border: none; border-radius: 10px; }
.action-btn::after { border: none; }
.action-btn-primary { color: #FAFAF7 !important; background: #4A6741 !important; }

/* ── 近期重要日期 ── */
.upcoming-card {
  margin-bottom: 24rpx;
}
.upcoming-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
}
.upcoming-icon {
  font-size: 16px;
}
.upcoming-days {
  margin-left: auto;
}

/* ── AI 洞察 ── */
.insights-card {
  margin-bottom: 24rpx;
  background: #F5F2EC;
  border-left: 6rpx solid #4A6741;
}
.insight-row {
  display: flex;
  gap: 8rpx;
  padding: 6rpx 0;
  line-height: 1.5;
}
.insight-dot {
  color: #4A6741;
  font-weight: bold;
}
