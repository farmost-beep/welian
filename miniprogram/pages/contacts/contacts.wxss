/* pages/contacts/contacts.wxss */

/* ── 搜索框 ── */
.search-bar {
  display: flex;
  align-items: center;
  background: #EDEBE3;
  border: 1rpx solid #D9D5C7;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1915;
}

.search-clear {
  font-size: 36rpx;
  color: #9A968C;
  padding: 0 8rpx;
}

/* ── 扫描按钮 ── */
.scan-btn {
  padding: 0 8rpx;
}
.scan-icon {
  font-size: 36rpx;
}

/* ── 扫描中 ── */
.scan-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
}

/* ── 分组栏 ── */
.group-bar { padding: 8rpx 0 16rpx; }
.group-bar picker { display: block; }
.group-picker {
  display: inline-block;
  padding: 16rpx 24rpx;
  background: #EDEBE3;
  border-radius: 20rpx;
  min-height: 60rpx;
}

/* 分组列表项 */
.group-item-card { padding: 24rpx; margin-bottom: 12rpx; }
.group-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.group-item-name { font-size: 30rpx; font-weight: 500; color: #1A1915; flex: 1; }
.group-item-count { flex-shrink: 0; margin-right: 16rpx; }
.group-item-arrow { font-size: 36rpx; flex-shrink: 0; }

/* 分组返回栏 */
.group-back-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background: #EDEBE3;
  border-radius: 12rpx;
}

/* ── 扫描结果弹窗 ── */
.scan-result-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.scan-result-card {
  background: #F5F4EE;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}
.scan-result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A7C59;
  display: block;
  margin-bottom: 24rpx;
  text-align: center;
}
.scan-result-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.info-row-edit {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.info-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1915;
  border: 1rpx solid #D9D5C7;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}
.info-label {
  font-size: 26rpx;
  color: #6B6860;
  flex-shrink: 0;
  width: 80rpx;
}
.info-value {
  font-size: 28rpx;
  color: #1A1915;
  font-weight: 500;
}
.scan-confidence-warn {
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}
.scan-result-actions {
  display: flex;
  flex-direction: column;
}

/* ── Tab 切换 ── */
.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #EDEBE3;
  border: 1rpx solid #D9D5C7;
  gap: 4rpx;
}

.tab-item.active {
  border-color: #C96442;
  background: #F2E8E0;
}

.tab-icon {
  font-size: 36rpx;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1915;
}

.tab-item.active .tab-text {
  color: #C96442;
}

.tab-item-network {
  background: #F5F4EE;
  border-style: dashed;
}
.tab-item-network .tab-text {
  color: #6B6860;
}
.tab-item-network:active {
  background: #EDEBE3;
}

.tab-meta {
  margin-top: 2rpx;
}

/* ── 添加联系人入口 ── */
.add-contact-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.add-contact-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #EDEBE3;
  border: 1rpx solid #D9D5C7;
}
.add-contact-icon {
  font-size: 32rpx;
}
.add-contact-text {
  font-size: 26rpx;
}

/* ── 列表 ── */
.list-header {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

/* ── 联系人卡片 ── */
.contact-card {
  padding: 24rpx 28rpx;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1915;
}

.contact-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cooldown-warn {
  font-weight: 600;
}

.contact-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.next-date {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #D9D5C7;
}

/* ── 加载更多 ── */
.load-more {
  text-align: center;
  padding: 32rpx 0;
}

/* ── 粘贴文本弹窗 ── */
.paste-textarea-wrap {
  margin-bottom: 24rpx;
}
.paste-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #1A1915;
  border: 1rpx solid #D9D5C7;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ── 粘贴结果列表 ── */
.paste-result-card {
  width: 640rpx;
}
.paste-result-list {
  max-height: 60vh;
  overflow-y: auto;
  margin-bottom: 24rpx;
}
.paste-contact-item {
  padding: 20rpx;
  background: #EDEBE3;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.paste-contact-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.paste-contact-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #C96442;
  flex-shrink: 0;
  width: 40rpx;
}
.paste-contact-name {
  font-weight: 600;
}
.paste-contact-fields {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.paste-contact-fields .info-input {
  font-size: 26rpx;
  padding: 10rpx 14rpx;
}
