<!-- pages/profile/profile.wxml — 个人画像 -->
<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dimmer text-sm">加载中…</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 完整度 -->
    <view class="completeness-bar">
      <text class="text-dim text-sm">画像完整度</text>
      <view class="completeness-track">
        <view class="completeness-fill" style="width:{{completenessPct}}%"></view>
      </view>
      <text class="completeness-num">{{completeness}}/12</text>
    </view>

    <!-- 展示模式 -->
    <block wx:if="{{!editing}}">
      <!-- 基本信息 -->
      <view class="card profile-group">
        <text class="section-title-sm">基本信息</text>
        <view wx:for="{{basicFields}}" wx:key="key" class="profile-row">
          <text class="profile-row-label text-dimmer text-xs">{{item.label}}</text>
          <text class="profile-row-value text-sm {{profile[item.key] ? '' : 'text-dimmer'}}">{{profile[item.key] || '未填写'}}</text>
        </view>
      </view>

      <!-- 沟通偏好 -->
      <view class="card profile-group">
        <text class="section-title-sm">沟通偏好</text>
        <view wx:for="{{commFields}}" wx:key="key" class="profile-row">
          <text class="profile-row-label text-dimmer text-xs">{{item.label}}</text>
          <text class="profile-row-value text-sm {{profile[item.key] ? '' : 'text-dimmer'}}">{{profile[item.key] || '未填写'}}</text>
        </view>
      </view>

      <!-- 目标与方向 -->
      <view class="card profile-group">
        <text class="section-title-sm">目标与方向</text>
        <view wx:for="{{goalFields}}" wx:key="key" class="profile-row">
          <text class="profile-row-label text-dimmer text-xs">{{item.label}}</text>
          <text class="profile-row-value text-sm {{profile[item.key] ? '' : 'text-dimmer'}}">{{profile[item.key] || '未填写'}}</text>
        </view>
      </view>

      <!-- 附注 -->
      <view wx:if="{{profile.notes}}" class="card profile-group">
        <text class="section-title-sm">附注</text>
        <text class="profile-row-value text-sm">{{profile.notes}}</text>
      </view>

      <button class="btn btn-block" bindtap="startEdit">编辑画像</button>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <!-- 基本信息 -->
      <view class="card profile-group">
        <text class="section-title-sm">基本信息</text>
        <view wx:for="{{basicFields}}" wx:key="key" class="profile-edit-row">
          <text class="field-label text-dimmer text-xs">{{item.label}}</text>
          <input class="field-input" placeholder="{{item.placeholder}}" value="{{profile[item.key] || ''}}" bindinput="onInput" data-key="{{item.key}}" />
        </view>
      </view>

      <!-- 沟通偏好 -->
      <view class="card profile-group">
        <text class="section-title-sm">沟通偏好</text>
        <view wx:for="{{commFields}}" wx:key="key" class="profile-edit-row">
          <text class="field-label text-dimmer text-xs">{{item.label}}</text>
          <input class="field-input" placeholder="{{item.placeholder}}" value="{{profile[item.key] || ''}}" bindinput="onInput" data-key="{{item.key}}" />
        </view>
      </view>

      <!-- 目标与方向 -->
      <view class="card profile-group">
        <text class="section-title-sm">目标与方向</text>
        <view wx:for="{{goalFields}}" wx:key="key" class="profile-edit-row">
          <text class="field-label text-dimmer text-xs">{{item.label}}</text>
          <textarea wx:if="{{textareaFields.indexOf(item.key) >= 0}}" class="field-input" placeholder="{{item.placeholder}}" value="{{profile[item.key] || ''}}" bindinput="onInput" data-key="{{item.key}}" auto-height maxlength="-1" />
          <input wx:else class="field-input" placeholder="{{item.placeholder}}" value="{{profile[item.key] || ''}}" bindinput="onInput" data-key="{{item.key}}" />
        </view>
      </view>

      <!-- 附注 -->
      <view class="card profile-group">
        <text class="section-title-sm">附注</text>
        <textarea class="field-input" placeholder="个人简介、背景资料、备忘…" value="{{profile.notes || ''}}" bindinput="onInput" data-key="notes" auto-height maxlength="-1" />
      </view>

      <view class="edit-actions">
        <button class="btn btn-block" style="margin-bottom:12px" bindtap="saveProfile" loading="{{saving}}">保存</button>
        <button class="btn btn-block btn-ghost" bindtap="cancelEdit">取消</button>
      </view>
    </block>
  </block>
</view>
