<!-- pages/profile/profile.wxml — 个人画像 -->
<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dimmer text-sm">加载中…</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 完整度 -->
    <view class="completeness-bar">
      <text class="text-dim text-sm">画像完整度</text>
      <text class="completeness-num">{{completeness}}/12</text>
    </view>

    <!-- 展示模式 -->
    <block wx:if="{{!editing}}">
      <view wx:for="{{fields}}" wx:key="key" class="card profile-field">
        <text class="field-label text-dimmer text-xs">{{item.label}}</text>
        <text class="field-value {{profile[item.key] ? '' : 'text-dimmer'}}">{{profile[item.key] || '未填写'}}</text>
      </view>

      <view wx:if="{{profile.notes}}" class="card profile-field">
        <text class="field-label text-dimmer text-xs">附注</text>
        <text class="field-value">{{profile.notes}}</text>
      </view>

      <button class="btn btn-block" bindtap="startEdit">编辑画像</button>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <view wx:for="{{fields}}" wx:key="key" class="card profile-field-edit">
        <text class="field-label text-dimmer text-xs">{{item.label}}</text>
        <textarea
          wx:if="{{textareaFields.indexOf(item.key) >= 0}}"
          class="field-input"
          placeholder="{{item.placeholder}}"
          value="{{profile[item.key] || ''}}"
          bindinput="onInput"
          data-key="{{item.key}}"
          auto-height
          maxlength="-1"
        />
        <input
          wx:else
          class="field-input"
          placeholder="{{item.placeholder}}"
          value="{{profile[item.key] || ''}}"
          bindinput="onInput"
          data-key="{{item.key}}"
        />
      </view>

      <!-- 附注 -->
      <view class="card profile-field-edit">
        <text class="field-label text-dimmer text-xs">附注</text>
        <textarea
          class="field-input"
          placeholder="个人简介、背景资料、备忘…"
          value="{{profile.notes || ''}}"
          bindinput="onInput"
          data-key="notes"
          auto-height
          maxlength="-1"
        />
      </view>

      <view class="edit-actions">
        <button class="btn btn-block" style="margin-bottom:12px" bindtap="saveProfile" loading="{{saving}}">保存</button>
        <button class="btn btn-block btn-ghost" bindtap="cancelEdit">取消</button>
      </view>
    </block>
  </block>
</view>
