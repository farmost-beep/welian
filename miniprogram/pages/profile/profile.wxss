/* pages/profile/profile.wxss */

.completeness-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 8rpx;
  margin-bottom: 16rpx;
}
.completeness-track {
  flex: 1;
  height: 8rpx;
  background: #E8E5DC;
  border-radius: 4rpx;
  overflow: hidden;
}
.completeness-fill {
  height: 100%;
  background: #4A6741;
  border-radius: 4rpx;
  transition: width 0.3s;
}
.completeness-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #6B6860;
  flex-shrink: 0;
}

/* 分组卡片 */
.profile-group {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.profile-group .section-title-sm {
  margin-bottom: 16rpx;
}

/* 展示模式行 */
.profile-row {
  display: flex;
  align-items: baseline;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F0EEE8;
}
.profile-row:last-child { border-bottom: none; }
.profile-row-label {
  width: 160rpx;
  flex-shrink: 0;
}
.profile-row-value {
  flex: 1;
  color: #1A1915;
  line-height: 1.5;
}

/* 编辑模式行 */
.profile-edit-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0EEE8;
}
.profile-edit-row:last-child { border-bottom: none; }
.field-label {
  display: block;
  margin-bottom: 6rpx;
}
.field-input {
  font-size: 28rpx;
  color: #1A1915;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #E8E5DC;
  min-height: 40rpx;
}

.edit-actions {
  margin-top: 24rpx;
}
.btn-ghost {
  background: transparent;
  color: #6B6860;
  border: 1rpx solid #D9D5C7;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
}
