<!-- pages/report/report.wxml — 关系回顾报告页（预览→分享，无温度评分） -->
<wxs src="../../utils/terminology.wxs" module="term" />
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="text-dim text-sm">正在生成关系回顾…</text>
  </view>

  <!-- 报告内容 -->
  <block wx:if="{{!loading && report}}">
    <view class="report-header">
      <text class="report-title">{{report.contactName}} 的关系回顾</text>
      <text class="text-dim text-sm">由 {{report.inviterName || '小维用户'}} 发起</text>
    </view>

    <!-- 数据驱动的事实 -->
    <view class="card">
      <text class="card-title">互动概况</text>
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-value">{{report.totalInteractions}}</text>
          <text class="stat-label text-dim text-xs">总互动</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{report.daysSinceLast}}</text>
          <text class="stat-label text-dim text-xs">距上次(天)</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{report.avgInterval}}</text>
          <text class="stat-label text-dim text-xs">平均间隔(天)</text>
        </view>
      </view>
    </view>

    <!-- 事实清单 -->
    <view class="card" wx:if="{{report.facts && report.facts.length > 0}}">
      <text class="card-title">关系记录</text>
      <view wx:for="{{report.facts}}" wx:key="index" class="suggestion-item">
        <text class="text-sm">• {{item}}</text>
      </view>
    </view>

    <!-- 上次互动摘要 -->
    <view class="card" wx:if="{{report.lastInteractionSummary}}">
      <text class="card-title">上次互动</text>
      <text class="text-dim text-sm">{{report.lastInteractionSummary}}</text>
      <text wx:if="{{report.lastInteractionDate}}" class="text-dimmer text-xs">{{report.lastInteractionDate}}</text>
    </view>

    <!-- 即将到来的重要日期 -->
    <view class="card" wx:if="{{report.upcomingDate}}">
      <text class="card-title">即将到来</text>
      <text class="text-sm">{{report.upcomingDate.label}}：{{report.upcomingDate.date}}</text>
    </view>

    <!-- 被分享者视角：引导试用 -->
    <view wx:if="{{isSharedView}}" class="cta-section">
      <view class="card cta-card">
        <text class="cta-title">你也想管理自己的关系网络？</text>
        <text class="text-dim text-sm">Welian 帮你记住每个重要的人，在合适的时机提醒你联系。</text>
        <button class="btn btn-primary" bindtap="startUsing">免费试用 Welian</button>
      </view>
    </view>

    <!-- 分享者视角：预览后分享 -->
    <view wx:if="{{!isSharedView}}" class="share-section">
      <text class="text-dim text-sm" style="margin-bottom:16rpx">确认报告内容后，分享给 {{report.contactName}}</text>
      <button class="btn btn-primary" open-type="share" aria-label="分享给 {{report.contactName}}">分享给 {{report.contactName}}</button>
      <text class="text-dim text-xs" style="margin-top:12rpx">对方打开后会看到这份回顾，并可选择关联你的关系记录</text>
    </view>
  </block>

  <!-- 昵称确认（被分享者） -->
  <view wx:if="{{isSharedView && !nicknameConfirmed}}" class="nickname-confirm">
    <view class="card">
      <text class="card-title">确认你的名字</text>
      <input
        type="nickname"
        class="nickname-input"
        placeholder="点击填写微信昵称"
        value="{{report.contactName}}"
        bindblur="onNicknameConfirm"
        focus="{{true}}"
      />
      <text class="text-dim text-xs">用于帮你匹配关系记录</text>
    </view>
  </view>

  <!-- 错误态 -->
  <view wx:if="{{!loading && !report && error}}" class="loading">
    <text class="text-accent text-sm">{{error}}</text>
    <view style="margin-top:12px"><button size="mini" bindtap="loadReport">重试</button></view>
  </view>
</view>
