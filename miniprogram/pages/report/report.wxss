/* pages/report/report.wxss — 关系体检报告页 */
.container { padding: 16px; }

.loading { text-align: center; padding: 40px 0; }

.report-header { text-align: center; margin-bottom: 20px; }
.report-title { font-size: 20px; font-weight: 600; display: block; margin-bottom: 4px; }

.card {
  background: #FAFAF7;
  border: 1px solid #E8E5DC;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}
.card-title { font-size: 15px; font-weight: 600; display: block; margin-bottom: 10px; }

/* 温度条 */
.temp-bar {
  height: 8px;
  background: #E8E5DC;
  border-radius: 4px;
  overflow: hidden;
  margin: 8px 0;
}
.temp-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A7C59, #6B9F7A);
  border-radius: 4px;
  transition: width 0.5s;
}
.temp-value { font-size: 28px; font-weight: 700; }

/* 统计行 */
.stat-row { display: flex; justify-content: space-around; }
.stat-item { text-align: center; }
.stat-value { font-size: 22px; font-weight: 700; display: block; }
.stat-label { display: block; margin-top: 2px; }

/* 建议 */
.suggestion-item { padding: 6px 0; }

/* CTA */
.cta-section { margin-top: 20px; }
.cta-card { text-align: center; }
.cta-title { font-size: 16px; font-weight: 600; display: block; margin-bottom: 8px; }

/* 分享 */
.share-section { margin-top: 20px; text-align: center; }
.share-section button { margin-bottom: 8px; }

/* 昵称确认 */
.nickname-confirm { margin-top: 16px; }
.nickname-input {
  border: 1px solid #D9D5C7;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 15px;
  margin-bottom: 8px;
}

/* 通用按钮 */
.btn {
  display: block;
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
  border: none;
}
.btn-primary {
  background: #4A6741;
  color: #fff;
  margin-top: 12px;
}
