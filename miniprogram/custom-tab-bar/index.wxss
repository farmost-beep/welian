.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #EDEBE3;
  border-top: 1rpx solid #D9D5C7;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}
.tab-text {
  font-size: 22rpx;
  color: #9A968C;
  margin-top: 6rpx;
}
.tab-item.active .tab-text {
  color: #C96442;
  font-weight: 600;
}
